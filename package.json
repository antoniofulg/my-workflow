{
  "name": "my-workflow",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "scripts": {
    "knowledge": "tsx tools/knowledge/src/cli.ts",
    "review:graft:build": "graft build",
    "review:graft:version": "graft --version",
    "test": "vitest run --dir tools",
    "test:python": "find tools -type f -name 'test_*.py' -print | sort | while read test; do python3 \"$test\" || exit $?; done",
    "test:all": "npm run test && npm run test:python"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "@nanonets/graft": "0.10.1",
    "skills": "1.5.23",
    "tsx": "4.23.1",
    "typescript": "5.9.3",
    "vitest": "4.1.10",
    "yaml": "2.9.0"
  }
}
