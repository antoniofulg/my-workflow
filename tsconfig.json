{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "lib": ["ES2022"],
    "strict": true,
    "skipLibCheck": true,
    "noUncheckedIndexedAccess": true,
    "types": ["node", "bun", "vitest/globals"]
  },
  "include": ["tools/knowledge/**/*.ts", "tools/shared/**/*.ts"]
}
